{
  "name": "eslint-plugin-superarchitecture",
  "version": "0.1.0",
  "license": "MIT",
  "description": "ESLint rules for the container / view rule: views never import containers, views are pure, containers have no markup, modules keep their views private.",
  "keywords": [
    "eslint",
    "eslintplugin",
    "react",
    "architecture",
    "containers",
    "views"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "bin": {
    "superarchitecture-check": "bin/check.js"
  },
  "files": [
    "index.js",
    "lib",
    "bin",
    "README.md"
  ],
  "scripts": {
    "check": "node bin/check.js"
  },
  "peerDependencies": {
    "eslint": ">=9"
  },
  "dependencies": {
    "typescript-eslint": "^8.20.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "typescript": "^5.6.0"
  }
}
